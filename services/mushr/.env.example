# Domain for HTTPS-enabled services (e.g. loft.hsimah.com)
# Services will be accessible at <service>.loft.hsimah.com with real TLS certs.
LOFT_DOMAIN=loft.hsimah.com

# Cloudflare API token for DNS-01 ACME challenge (Let's Encrypt cert issuance).
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone > Zone > Read, Zone > DNS > Edit
# Scope: Include all zones (or the specific zone for your domain)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here

# Cloudflare Tunnel token for external access to Pawst (hbla.ke + hsimah.com).
# Create at: https://one.dash.cloudflare.com/ → Networks → Tunnels → Create
# Connector: Cloudflared. Then add public hostnames per the blocks below.
TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# hbla.ke: Add the hbla.ke domain to Cloudflare and ensure the API token
# above covers that zone. Then add a Cloudflare Tunnel public hostname:
#   hostname: hbla.ke → HTTPS → mushr:443
#   Origin Server Name: hbla.ke

# hsimah.com: Add the hsimah.com domain to Cloudflare and ensure the API
# token above covers that zone. Then add a Cloudflare Tunnel public hostname:
#   hostname: hsimah.com → HTTPS → mushr:443
#   Origin Server Name: hsimah.com

# Basic auth for briefing.loft.hsimah.com — sputnik's briefing page, the one
# route that serves mail content without an application login in front of it.
#
# ⚠ BRIEFING_HASH MUST NOT BE EMPTY. An empty value leaves Caddy parsing
#   `basic_auth { loft }`, which is a syntax error — mushr then fails to start
#   and takes every route in the fleet down with it, not just this one. If you
#   are not deploying the briefing page yet, delete the briefing block from the
#   Caddyfile rather than leaving the hash blank.
#
# Generate the hash (bcrypt, starts with $2a$). Omit --plaintext and it prompts
# without echoing, keeping the password out of your shell history:
#   sudo docker exec -it mushr caddy hash-password
#
# ⚠ DOUBLE EVERY DOLLAR SIGN when you paste the hash in below. Compose
#   interpolates $ in .env values, so $2a$14$dj7m... is read as the variables
#   $2a, $14 and $dj7m and each is replaced with a blank string — Caddy then
#   gets a mangled hash and rejects the correct password. Compose says so, but
#   only in a warning that is easy to miss in a rebuild's output:
#     WARN[0000] The "dj7m" variable is not set. Defaulting to a blank string.
#   So $2a$14$dj7m...  becomes  $$2a$$14$$dj7m...
#   Confirm it survived:  sudo docker exec mushr printenv BRIEFING_HASH
#   That must print SINGLE dollars, matching what hash-password gave you.
#
# Then verify the Caddyfile parses with the new values BEFORE rebuilding, so a
# bad value never reaches the running proxy:
#   sudo docker run --rm --env-file services/mushr/.env \
#     -v ./services/mushr/Caddyfile:/etc/caddy/Caddyfile:ro \
#     mushr-caddy:2.11.4 caddy validate --config /etc/caddy/Caddyfile
#
# Put the same user and plaintext password into services/houstn/.env as
# HOMEPAGE_VAR_BRIEFING_USER / HOMEPAGE_VAR_BRIEFING_PASSWORD so the Homepage
# tile can read the manifest.
BRIEFING_USER=loft
BRIEFING_HASH=

# Before deploying, also edit dnsmasq.conf and replace the listen-address
# and address entries with space-needle's actual LAN IP.
# Find it with: ip addr show | grep 'inet 192'
