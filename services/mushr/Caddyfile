# sputnik — Open WebUI chat surface. Note there is deliberately NO route for
# ollama itself: it has no authentication, so it stays on the bridge only.
sputnik.{$LOFT_DOMAIN} {
	import cloudflare_tls
	reverse_proxy open-webui:8080
}

n8n.{$LOFT_DOMAIN} {
	import cloudflare_tls
	reverse_proxy n8n:5678
}

# sputnik — the briefing page. Static files, not a proxy: the renderer comes
# from services/sputnik/briefing-web, and n8n's latest.json is served beneath
# it at /data/ from a separate mount.
#
# This is the only route serving mail content to an unauthenticated reader, so
# it carries basic_auth where the rest of the LAN-only routes rely on the app's
# own login. Homepage passes the same credentials to read the manifest.
#
# Deliberately no http://briefing.space-needle counterpart — basic_auth over
# plain HTTP would put the password on the wire in cleartext. Keep it off the
# Cloudflare Tunnel's public hostname list for the same reason as n8n.
briefing.{$LOFT_DOMAIN} {
	import cloudflare_tls
	basic_auth {
		{$BRIEFING_USER} {$BRIEFING_HASH}
	}
	# Two roots, because the mounts are siblings rather than nested: the data
	# under /data/* comes from n8n's output directory, everything else is the
	# tracked renderer. handle_path strips the prefix, so /data/latest.json
	# reads /srv/briefing-data/latest.json.
	handle_path /data/* {
		root * /srv/briefing-data
		file_server
	}
	handle {
		root * /srv/briefing
		file_server
	}
}

hbla.ke {
	import cloudflare_tls
	reverse_proxy pawst:80
}

http://hbla.ke {
	redir https://hbla.ke{uri} permanent
}

