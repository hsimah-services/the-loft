# Reachable over plain HTTP for convenience, but always use the HTTPS name for
# Google OAuth — the registered redirect URI is scheme-exact.
http://n8n.space-needle:80 {
	reverse_proxy n8n:5678
}

http://space-needle:80 {
	reverse_proxy pupyrus:80
}

http://*.space-needle:80 {
	respond "Unknown service" 404
}
