# Sputnik — local LLM engine + assistant surfaces
#
# Compose profiles control which containers run:
#   engine — ollama (inference server; no auth, loopback + bridge only)
#   chat   — open-webui (conversational UI at https://sputnik.$LOFT_DOMAIN)
#   agent  — n8n (scheduled workflows at https://n8n.$LOFT_DOMAIN)
#
# space-needle (the only host with the RAM and cores for this):
#   COMPOSE_PROFILES=engine,chat,agent
#
# Nothing else in the fleet runs sputnik — the Pi hosts cannot serve a model.

COMPOSE_PROFILES=engine,chat,agent

# ── Shared ───────────────────────────────────────────────────────────────────
# Must match services/mushr/.env — compose interpolates it into the n8n and
# open-webui hostnames, and Caddy routes on the same value.
LOFT_DOMAIN=loft.hsimah.com
TZ=America/Los_Angeles

# ── Ollama ───────────────────────────────────────────────────────────────────
# Context window in tokens. 16384 fits an agent turn (tool schemas + a mail
# thread) comfortably. KV cache scales with this — drop to 8192 if the box is
# RAM-tight, raise only with headroom to spare.
OLLAMA_CONTEXT_LENGTH=16384

# ── Open WebUI ───────────────────────────────────────────────────────────────
# Signing key for session cookies. Generate once and keep it — rotating it logs
# every user out:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=

# Leave true to create the first (admin) account, then set to false and
# `loft-ctl rebuild sputnik` so the login page stops offering signup.
ENABLE_SIGNUP=true

# ── n8n ──────────────────────────────────────────────────────────────────────
# Encrypts every stored credential, including the Google OAuth refresh token.
# Generate once:
#   openssl rand -hex 32
#
# BACK THIS UP. Losing it means every saved credential in /opt/sputnik/n8n is
# unrecoverable and every Google connection must be re-authorised from scratch.
N8N_ENCRYPTION_KEY=

# ── Google OAuth (Gmail + Calendar) ──────────────────────────────────────────
# These are entered in the n8n UI (Credentials → Google OAuth2 API), NOT here —
# n8n stores them encrypted with N8N_ENCRYPTION_KEY above. Recorded here only
# so the setup sequence lives next to the rest of the service config.
#
#  1. console.cloud.google.com → new project (e.g. "loft-sputnik")
#  2. APIs & Services → Library → enable "Gmail API" and "Google Calendar API"
#  3. APIs & Services → OAuth consent screen:
#       User type: External   (required for a personal @gmail.com account)
#       Add your own address under "Test users"
#  4. Scopes — read-only to start. Add exactly these and nothing more:
#       https://www.googleapis.com/auth/gmail.readonly
#       https://www.googleapis.com/auth/calendar.readonly
#  5. Credentials → Create credentials → OAuth client ID → Web application
#       Authorised redirect URI (exact, no trailing slash):
#         https://n8n.loft.hsimah.com/rest/oauth2-credential/callback
#  6. PUBLISH THE APP TO PRODUCTION.
#       While the consent screen is in "Testing" status Google expires refresh
#       tokens after 7 days and the assistant silently stops working every
#       week. Publishing shows an "unverified app" interstitial you click
#       through as the developer; verification is only required to distribute
#       to other people.
#  7. Paste the client ID and secret into n8n → Credentials → Google OAuth2 API,
#     then click "Connect my account" from a browser ON THE LAN.
#
# Step 7 works without exposing n8n to the internet: Google never fetches the
# redirect URI itself, your browser does. mushr-dns resolves
# n8n.loft.hsimah.com to 192.168.86.28 on the LAN, and Caddy serves a real
# Let's Encrypt cert there, so the HTTPS redirect completes locally.
